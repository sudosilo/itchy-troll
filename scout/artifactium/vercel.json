{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://artifactium-backend-production.up.railway.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/artifactium-v6.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(artifactium-v6|artifactium-archive-v6).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}