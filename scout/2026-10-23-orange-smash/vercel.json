{
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':!src-tauri' ':!.github' ':!tools' ':!supabase'",
  "rewrites": [
    {
      "source": "/api/time",
      "destination": "https://offset-listener.vercel.app/api/time"
    },
    {
      "source": "/api/recognize",
      "destination": "https://offset-listener.vercel.app/api/recognize"
    },
    {
      "source": "/api/youtube-search",
      "destination": "https://offset-listener.vercel.app/api/youtube-search"
    },
    {
      "source": "/api/bpm",
      "destination": "https://offset-listener.vercel.app/api/bpm-lookup"
    },
    {
      "source": "/api/beatmatch",
      "destination": "https://offset-listener.vercel.app/api/beatmatch"
    },
    {
      "source": "/api/artist-info",
      "destination": "https://offset-listener.vercel.app/api/artist-info"
    },
    {
      "source": "/api/album-info",
      "destination": "https://offset-listener.vercel.app/api/album-info"
    },
    {
      "source": "/api/auto-pick",
      "destination": "https://offset-listener.vercel.app/api/auto-pick"
    },
    {
      "source": "/api/energy",
      "destination": "https://offset-listener.vercel.app/api/energy"
    }
  ],
  "headers": [
    {
      "source": "/s",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
